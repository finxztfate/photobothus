# Copy this file to .env and fill in the values. .env is not committed.

# Leave empty to use same-origin + CRA proxy (works for localhost, LAN IP, and tunnels)
REACT_APP_API_URL=
# Google OAuth client ID (Web). Use the same value as GOOGLE_CLIENT_ID in server/.env
REACT_APP_GOOGLE_CLIENT_ID=
GENERATE_SOURCEMAP=false
