PORT=4000
JWT_SECRET=photobothus-dev-secret-change-me
CLIENT_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=photobothus
GOOGLE_CLIENT_ID=
# Optional (production / Railway)
# MYSQL_URL / MYSQLHOST etc. are used automatically when DB_HOST is not set
# Photos are stored as YYYY/MM/DD/<random>.<ext> under this directory.
# The file bytes are encrypted. Set a 64-character hex key (openssl rand -hex 32).
# PHOTO_ENCRYPTION_KEY=
# UPLOADS_DIR=/data/uploads
# ADMIN_PASSWORD=replaces the default admin123 when `npm run db:init` runs
